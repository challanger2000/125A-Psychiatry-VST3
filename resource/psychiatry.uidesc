<?xml version="1.0" encoding="UTF-8"?>
<vstgui-ui-description version="1">
  <fonts><font name="ValueFont" font-name="Arial" size="18" bold="true"/></fonts>
  <colors>
    <color name="Text" rgba="#f5e2c3ff"/>
    <color name="Black" rgba="#18120eff"/>
    <color name="Muted" rgba="#997f60ff"/>
    <color name="Accent" rgba="#b96128ff"/>
  </colors>
  <bitmaps>
    <bitmap name="Faceplate" path="faceplate.png"/>
    <bitmap name="MacroAtlas" path="macro-atlas.png" multiframe-num-frames="128" mulitframe-frames-per-row="8" multiframe-size="128, 128"/>
    <bitmap name="TherapyAtlas" path="therapy-atlas.png" multiframe-num-frames="128" mulitframe-frames-per-row="8" multiframe-size="224, 224"/>
  </bitmaps>
  <template class="CViewContainer" name="view" origin="0, 0" size="1536, 1024" minSize="1536, 1024" maxSize="1536, 1024" bitmap="Faceplate" transparent="false" mouse-enabled="true">
